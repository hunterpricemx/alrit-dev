# Producción — copia a .env en el servidor y rellena con valores REALES y fuertes.
# NUNCA commitees el .env real.

# ---------- Base de datos ----------
DATABASE_URL="postgresql://alrit:CAMBIA_ESTA_PASSWORD@db:5432/alrit?schema=public"
POSTGRES_USER=alrit
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD
POSTGRES_DB=alrit

# ---------- Auth.js v5 ----------
# openssl rand -base64 32
AUTH_SECRET=CAMBIA_genera_uno_con_openssl
AUTH_URL=https://alrit.dev
AUTH_TRUST_HOST=true
ADMIN_EMAIL=tu-correo@alrit.dev
ADMIN_NAME=Tu Nombre
# node -e "console.log(require('bcryptjs').hashSync('TU_PASSWORD',10))"
ADMIN_PASSWORD_HASH='$2b$10$reemplaza-con-tu-hash-bcrypt'

# ---------- MinIO / S3 (biblioteca de medios) ----------
# S3_ENDPOINT lo usa el servidor (red interna). S3_PUBLIC_URL lo ve el navegador:
# debe ser un dominio público → publica MinIO:9000 vía el proxy en media.alrit.dev.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://media.alrit.dev/alrit-media
S3_REGION=us-east-1
S3_BUCKET=alrit-media
S3_ACCESS_KEY=CAMBIA_access_key_fuerte
S3_SECRET_KEY=CAMBIA_secret_key_fuerte
MINIO_ROOT_USER=CAMBIA_access_key_fuerte
MINIO_ROOT_PASSWORD=CAMBIA_secret_key_fuerte

# ---------- Analítica (opcional; también configurable en /admin/configuracion) ----------
NEXT_PUBLIC_GA_ID=

# ---------- Correo / avisos de leads (opcional pero recomendado) ----------
# Crea una cuenta gratis en https://resend.com y verifica tu dominio (alrit.dev).
RESEND_API_KEY=                          # API key de Resend (re_...)
MAIL_FROM="Alrit.dev <leads@alrit.dev>"  # remitente verificado en Resend
LEADS_NOTIFY_TO=                         # a dónde llegan los avisos (vacío = usa el email de /admin/configuracion)

# ---------- Webhook de leads (bot / n8n / CRM) — opcional ----------
LEADS_WEBHOOK_URL=                       # ej. https://wa.programalab.dev/public/leads/alrit-dev
LEADS_WEBHOOK_KEY=                       # se envía como header x-lead-key (secreto; NO lo subas al repo)

# ---------- Widget de chat web — opcional ----------
# Vacía = el widget no se renderiza y no se pide ningún archivo. Rellénala solo
# cuando el backend del widget esté desplegado y sirviendo widget.js.
# La clave NO es un secreto: viaja visible en el HTML. Lo que protege el widget
# es la lista de orígenes permitidos configurada en su servidor.
# Requiere además que ese servidor responda `Cross-Origin-Resource-Policy:
# cross-origin` en la ruta del widget, o el navegador bloqueará la carga.
NEXT_PUBLIC_WEBCHAT_KEY=                 # ej. wk_...
